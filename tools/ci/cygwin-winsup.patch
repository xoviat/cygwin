+  InitializeObjectAttributes (&attr, name, OBJ_OPENIF, root,
+			      everyone_sd (CYG_SHARED_DIR_ACCESS));
+  for (int tries = 0;; tries++)
+    {
+      *err = NtCreateDirectoryObject (&dir, CYG_SHARED_DIR_ACCESS, &attr);
+      if (NT_SUCCESS (*err) || !retry || tries >= 100)
+	break;
